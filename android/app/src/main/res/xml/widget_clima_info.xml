<?xml version="1.0" encoding="utf-8"?>
<!-- Todo el ancho y dos filas: se pone debajo del reloj, centrado como él.
     Se puede achicar a cuatro columnas y estirar. Sólo existe en el APK del
     clima (el receiver se declara en src/clima). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="80dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="70dp"
    android:targetCellWidth="5"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_clima"
    android:previewLayout="@layout/widget_clima"
    android:description="@string/clima_widget_desc"
    android:updatePeriodMillis="1800000" />
